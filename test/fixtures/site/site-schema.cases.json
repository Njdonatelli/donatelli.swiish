      }
    ],
    "expect": [
      "bookingUrl"
    ]
  },
  {
    "name": "a plain-http booking link",
    "set": [
      {
        "path": "bookingUrl",
        "value": "http://cal.com/x"
      }
    ],
    "expect": [
      "bookingUrl"
    ]
  },
  {
    "name": "no booking link",
    "set": [
      {
        "path": "bookingUrl",
        "value": null
      }
    ],
    "expect": []
