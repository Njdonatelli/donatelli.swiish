    "set": [
      {
        "path": "tagline",
        "value": "<script>x</script>"
      }
    ],
    "expect": [
      "tagline"
    ]
  },
  {
    "name": "an HTML entity",
    "set": [
      {
        "path": "tagline",
        "value": "A &amp; B"
      }
    ],
    "expect": [
      "tagline"
    ]
  },
  {
    "name": "a bare ampersand before a space",
    "set": [
      {
        "path": "tagline",
        "value": "A & B"
      }
    ],
    "expect": []
  },
  {
    "name": "a control character",
    "set": [
      {
        "path": "tagline",
        "value": "Ring\u0007"
      }
    ],
    "expect": [
      "tagline"
    ]
  },
  {
    "name": "a booking host the CSP does not frame",
    "set": [
      {
