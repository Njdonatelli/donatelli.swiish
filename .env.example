# donatelli.tech admin (Swiish fork) environment
# Copy to .env and fill in values on the host. Never commit .env.
# Every value is empty here on purpose: an empty value means "use the default" (noted per line),
# and secrets are generated on the host. docs/donatelli-deploy.md explains each group.

# === Core ===

# development (default) or production. docker-compose.yml pins production.
NODE_ENV=
# Default 3000. Keep 3000 in Docker; compose maps it to 127.0.0.1:8095.
PORT=
# Required in production: the https admin origin, e.g. https://admin.donatelli.tech
# Default in development: http://localhost:3000
APP_URL=
# Optional. Defaults to the APP_URL origin (plus localhost:3000/8095 in development).
# If set in production it must include the APP_URL origin, or the server will not start.
ALLOWED_ORIGINS=
# Secret, required. At least 32 characters in production. Generate: openssl rand -base64 48
JWT_SECRET=
# Default 24h. Seconds, or a number with m, h or d. The login cookie lasts as long.
JWT_EXPIRES_IN=
# Secret, one-time. Required by /setup in production; remove it and restart after setup.
# Generate: openssl rand -base64 48
SETUP_TOKEN=
# true behind a TLS reverse proxy that forwards X-Forwarded-Proto
FORCE_HTTPS=
# Default America/Los_Angeles. Times in the status line and notification emails.
ADMIN_TIME_ZONE=
# Never true in production: demo mode skips login. The server refuses to start with it.
DEMO_MODE=

# === Email (optional) ===
# Without SMTP, password reset runs from the host shell: node scripts/set-password.js <email>

SMTP_HOST=
# Default 587
SMTP_PORT=
# true for port 465
SMTP_SECURE=
SMTP_USER=
# Secret
SMTP_PASSWORD=
SMTP_FROM=

# === Website tools (GitHub) ===

# Secret. Fine-grained PAT for the website repo only: Contents and Actions read/write,
# 90-day expiry. Unset means the Website tab is off.
SITE_GITHUB_TOKEN=
# Default Njdonatelli/donatelli-website
SITE_GITHUB_REPO=
# Default main
SITE_GITHUB_BRANCH=
# Default admin-preview. Must differ from SITE_GITHUB_BRANCH (previews force-update it).
SITE_PREVIEW_BRANCH=
# Defaults site.yml and rollback.yml
SITE_WORKFLOW=
SITE_ROLLBACK_WORKFLOW=
# Defaults data/site.json, data/site.schema.json, outputs/data/credentials.json
SITE_CONFIG_PATH=
SITE_SCHEMA_PATH=
SITE_CREDENTIALS_PATH=
# Default https://donatelli.tech
SITE_LIVE_URL=
# Default https://admin-preview.donatelli-services.pages.dev
SITE_PREVIEW_URL=
# Default https://api.github.com. Must be https in production.
SITE_GITHUB_API_URL=

# === Card connections (visitor details from donatelli.tech/card/) ===

# Secret. At least 32 characters; the same value goes on Cloudflare Pages (Production only).
# Unset means the ingest route answers 503. Generate: openssl rand -base64 48
CONNECT_INGEST_SECRET=
# Secret. The old value, only while rotating CONNECT_INGEST_SECRET.
CONNECT_INGEST_SECRET_PREVIOUS=
# Default donatelli-tech (created by /setup from the organisation name donatelli.tech)
CONNECT_ORG_SLUG=
# Default 200 connections per UTC day
CONNECT_DAILY_CAP=
# Optional recipient of the "new connection" email. The email carries no visitor details.
CONNECT_NOTIFY_EMAIL=

# === Backups ===

# Default 0 (off). Hours between in-process VACUUM INTO backups to data/backups/ (max 576).
BACKUP_INTERVAL_HOURS=
# Default 14 backup files kept
BACKUP_KEEP=
